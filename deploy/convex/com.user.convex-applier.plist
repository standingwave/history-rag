<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Convex spike: keep tools/convex-applier.py running while the Mac is
     awake so phone-side task toggles land in the vault. The deploy key is
     read from deploy/convex/.env.local. Fill in __REPO__ and __HOME__, then:
       cp com.user.convex-applier.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.user.convex-applier.plist
     KeepAlive restarts it after sleep/wake network drops. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.user.convex-applier</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.claude/rag-venv/bin/python</string>
    <string>__REPO__/tools/convex-applier.py</string>
    <string>--kick</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/.claude/convex-applier.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude/convex-applier.log</string>
</dict>
</plist>
